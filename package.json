{
  "name": "pokegames-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "test": "npm run test --workspaces --if-present",
    "check:specs": "node scripts/check-specs.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:specs",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.1"
  }
}
