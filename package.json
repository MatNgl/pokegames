{
  "name": "pokegames-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "test": "npm run test --workspaces --if-present",
    "check:specs": "node scripts/check-specs.mjs",
    "verify": "npm run build -w @pokegames/shared-types && npm run typecheck && npm run lint && npm run test && npm run check:specs",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.1"
  },
  "overrides": {
    "tar": "^7.5.21",
    "qs": "^6.16.0",
    "file-type": "^21.3.4"
  }
}
