datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Pokemon {
  id             Int           @id // Pokedex ID
  pokedexId      Int           @unique
  nameFr         String
  nameEn         String
  category       String?
  generation     Int
  spriteRegular  String
  spriteShiny    String?
  statsHp        Int
  statsAtk       Int
  statsDef       Int
  statsSpeAtk    Int
  statsSpeDef    Int
  statsSpeed     Int
  weight         Float?
  height         Float?
  evolutionStage    Int     @default(1) // 1 = forme de base, 2, 3... (nb de pré-évolutions + 1)
  isFinalEvolution  Boolean @default(true) // vrai si aucune évolution suivante
  hasMega           Boolean @default(false)
  megaSpriteRegular String?
  megaSpriteShiny   String?
  types          PokemonType[]
  evolutions     Evolution[]   @relation("PokemonEvolutions")
  evolvedFrom    Evolution[]   @relation("PokemonPreEvolutions")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([generation])
  @@index([nameFr])
}

model Type {
  id       Int           @id @default(autoincrement())
  nameFr   String        @unique
  nameEn   String        @unique
  image    String
  pokemons PokemonType[]
}

model PokemonType {
  pokemonId Int
  typeId    Int
  slot      Int     @default(1)
  pokemon   Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  type      Type    @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@id([pokemonId, typeId])
}

model Evolution {
  id             Int     @id @default(autoincrement())
  pokemonId      Int
  targetId       Int
  condition      String?
  pokemon        Pokemon @relation("PokemonEvolutions", fields: [pokemonId], references: [id], onDelete: Cascade)
  target         Pokemon @relation("PokemonPreEvolutions", fields: [targetId], references: [id], onDelete: Cascade)
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  username       String             @unique
  passwordHash   String
  role           String             @default("USER")
  avatarUrl      String?
  createdAt      DateTime           @default(now())
  gameHistory    GameHistory[]
  dailyResults   DailyResult[]
  pokedexEntries UserPokedexEntry[]
  pokedexSpawns  PokedexSpawn[]
}

model GameHistory {
  id          String   @id @default(uuid())
  userId      String
  gameType    String   // "WHO_IS_IT", "MOTUS", "PLUS_MINUS", "INTRUDER", "GUESS_WHO"
  score       Int
  isMulti     Boolean  @default(false)
  playedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Journal d'audit détaillé pour les administrateurs et l'analyse anti-triche/statistiques,
/// alimenté en arrière-plan par des événements de domaine (Event Emitter / Job Event).
model GameAuditLog {
  id               String   @id @default(uuid())
  roundId          String   @unique
  gameType         String   // "WHO_IS_IT", "MOTUS", "PLUS_MINUS", "INTRUDER", "GUESS_WHO"
  userId           String?  // Optionnel : enregistre aussi les parties de joueurs non connectés/invités
  targetPokemonId  Int
  targetNameFr     String
  userGuess        String?
  isSuccess        Boolean
  scoreEarned      Int      @default(0)
  durationSeconds  Int
  hintsUsedCount   Int      @default(0)
  isMultiplayer    Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([gameType, isSuccess])
  @@index([createdAt])
}

/// Historique des tirages quotidiens, global et partage par tous les joueurs (les defis sont
/// deterministes et identiques pour tous). Sert a eviter de retomber sur les memes Pokemon
/// (ou les memes stats) d'un jour a l'autre. Renseigne par HistoryService lors de la generation
/// d'un defi ; interroge par les generateurs pour exclure les tirages recents.
model DailyPick {
  id        String   @id @default(uuid())
  game      String // GameType : "WHO_IS_IT", "MOTUS", ...
  scope     String   @default("") // mode ou niveau ("FIND_SHINY", "FACILE", ...), vide si sans objet
  pickDate  DateTime @db.Date // date UTC du tirage
  pokemonId Int? // Pokemon tire (null si non applicable)
  detail    String? // dimension secondaire a varier (ex. stat "SPEED", critere "TYPE")
  createdAt DateTime @default(now())

  @@index([game, scope, pickDate])
  @@index([game, scope, pokemonId])
  @@index([game, scope, detail])
}

/// Resultat quotidien d'un joueur connecte pour un defi (jeu x scope x jour). Sert au verrou serveur
/// de l'unicite quotidienne, a l'historique joueur et aux futurs classements. Une seule ligne par
/// (utilisateur, jeu, scope, jour). Les invites ne sont pas persistes (localStorage cote client).
/// Configuration dynamique des jeux : source de verite unique, editable via l'admin. Chargee en
/// memoire au demarrage (seedee depuis les valeurs par defaut de game-config.ts si absente). Les
/// services de jeu lisent leur config via GameConfigService, plus aucune constante lue directement.
model GameConfig {
  key       String   @id // "WHO_IS_IT", "MOTUS", "PLUS_MINUS", ..., "ANTI_REPEAT"
  value     Json
  updatedAt DateTime @updatedAt @default(now())
}

/// Journal des modifications de configuration : qui a change quoi, quand, et avec quelle valeur
/// avant/apres. La config pilote l'equilibrage des jeux a chaud, une modification malheureuse doit
/// pouvoir etre retracee et annulee.
model AdminConfigLog {
  id        String   @id @default(uuid())
  key       String // cle de GameConfig modifiee
  action    String   @default("UPDATE") // "UPDATE" (edition) ou "RESET" (retour aux defauts)
  adminId   String? // compte auteur ; null si le compte a ete supprime depuis
  adminName String // pseudo fige a l'instant du changement (survit a la suppression du compte)
  before    Json
  after     Json
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

model DailyResult {
  id String @id @default(uuid())
  // Un resultat appartient soit a un compte (userId), soit a un invite (guestId + guestName).
  // Exactement un des deux est renseigne ; les nulls rendent chaque contrainte unique inoffensive
  // pour l'autre type de joueur (Postgres traite les nulls comme distincts).
  userId          String?
  guestId         String? // identifiant invite persiste cote client (localStorage), ex. "g_xxxx"
  guestName       String? // pseudo affiche de l'invite, ex. "player_a3f9"
  gameType        String // "WHO_IS_IT", "MOTUS", ...
  scope           String   @default("") // niveau et/ou mode ("FACILE", "FIND_SHINY:MOYEN", ...)
  dayDate         DateTime @db.Date // jour UTC du defi
  won             Boolean  @default(false)
  // Metriques generiques : chaque jeu renseigne celles qui le concernent (classement selon le jeu).
  attempts        Int? // Silhouette / Motus : nombre d'essais
  score           Int? // ex. Who-is-it : capital restant
  correctCount    Int? // Plus ou Moins / Intrus / Shiny / Juste Stat : bonnes reponses
  totalRounds     Int?
  durationSeconds Int?
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameType, scope, dayDate])
  @@unique([guestId, gameType, scope, dayDate])
  @@index([gameType, scope, dayDate])
  @@index([userId, dayDate])
}

/// Pokedex personnel : chaque Pokemon collecte (easter egg aujourd'hui, autres sources plus tard).
/// `seen` sert la pastille "nouveau" : passe a true quand le joueur ouvre son Pokedex.
model UserPokedexEntry {
  id          String   @id @default(uuid())
  userId      String
  pokemonId   Int // Pokemon.id (= numero de Pokedex national)
  source      String   @default("EASTER_EGG") // origine de la capture
  seen        Boolean  @default(false)
  collectedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pokemonId, source])
  @@index([userId])
}

/// Apparitions du jour d'un joueur (10/jour). Une par zone (ecran) : fixe pour la journee, ce qui
/// empeche de rafraichir une page pour en faire apparaitre de nouvelles. Le token opaque valide la
/// collecte (idempotente). Autorite serveur : le client ne connait jamais le pokemonId avant collecte.
model PokedexSpawn {
  id          String    @id @default(uuid())
  userId      String
  dayDate     DateTime  @db.Date
  zone        String // ecran ou apparait la silhouette (ex. "home", "quests", "motus")
  pokemonId   Int
  sessionHash String // sprite masque (proxy /api/sprites/:sessionHash)
  token       String    @unique
  collected   Boolean   @default(false)
  collectedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayDate, zone])
  @@index([userId, dayDate])
}

