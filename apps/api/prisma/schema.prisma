datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Pokemon {
  id             Int           @id // Pokedex ID
  pokedexId      Int           @unique
  nameFr         String
  nameEn         String
  category       String?
  generation     Int
  spriteRegular  String
  spriteShiny    String?
  statsHp        Int
  statsAtk       Int
  statsDef       Int
  statsSpeAtk    Int
  statsSpeDef    Int
  statsSpeed     Int
  weight         Float?
  height         Float?
  evolutionStage    Int     @default(1) // 1 = forme de base, 2, 3... (nb de pré-évolutions + 1)
  isFinalEvolution  Boolean @default(true) // vrai si aucune évolution suivante
  hasMega           Boolean @default(false)
  megaSpriteRegular String?
  megaSpriteShiny   String?
  types          PokemonType[]
  evolutions     Evolution[]   @relation("PokemonEvolutions")
  evolvedFrom    Evolution[]   @relation("PokemonPreEvolutions")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([generation])
  @@index([nameFr])
}

model Type {
  id       Int           @id @default(autoincrement())
  nameFr   String        @unique
  nameEn   String        @unique
  image    String
  pokemons PokemonType[]
}

model PokemonType {
  pokemonId Int
  typeId    Int
  slot      Int     @default(1)
  pokemon   Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  type      Type    @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@id([pokemonId, typeId])
}

model Evolution {
  id             Int     @id @default(autoincrement())
  pokemonId      Int
  targetId       Int
  condition      String?
  pokemon        Pokemon @relation("PokemonEvolutions", fields: [pokemonId], references: [id], onDelete: Cascade)
  target         Pokemon @relation("PokemonPreEvolutions", fields: [targetId], references: [id], onDelete: Cascade)
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  username     String        @unique
  passwordHash String
  role         String        @default("USER")
  avatarUrl    String?
  eloScore     Int           @default(1000)
  createdAt    DateTime      @default(now())
  gameHistory  GameHistory[]
  dailyResults DailyResult[]
}

model GameHistory {
  id          String   @id @default(uuid())
  userId      String
  gameType    String   // "WHO_IS_IT", "MOTUS", "PLUS_MINUS", "INTRUDER", "GUESS_WHO"
  score       Int
  isMulti     Boolean  @default(false)
  playedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Journal d'audit détaillé pour les administrateurs et l'analyse anti-triche/statistiques,
/// alimenté en arrière-plan par des événements de domaine (Event Emitter / Job Event).
model GameAuditLog {
  id               String   @id @default(uuid())
  roundId          String   @unique
  gameType         String   // "WHO_IS_IT", "MOTUS", "PLUS_MINUS", "INTRUDER", "GUESS_WHO"
  userId           String?  // Optionnel : enregistre aussi les parties de joueurs non connectés/invités
  targetPokemonId  Int
  targetNameFr     String
  userGuess        String?
  isSuccess        Boolean
  scoreEarned      Int      @default(0)
  durationSeconds  Int
  hintsUsedCount   Int      @default(0)
  isMultiplayer    Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([gameType, isSuccess])
  @@index([createdAt])
}

/// Historique des tirages quotidiens, global et partage par tous les joueurs (les defis sont
/// deterministes et identiques pour tous). Sert a eviter de retomber sur les memes Pokemon
/// (ou les memes stats) d'un jour a l'autre. Renseigne par HistoryService lors de la generation
/// d'un defi ; interroge par les generateurs pour exclure les tirages recents.
model DailyPick {
  id        String   @id @default(uuid())
  game      String // GameType : "WHO_IS_IT", "MOTUS", ...
  scope     String   @default("") // mode ou niveau ("FIND_SHINY", "FACILE", ...), vide si sans objet
  pickDate  DateTime @db.Date // date UTC du tirage
  pokemonId Int? // Pokemon tire (null si non applicable)
  detail    String? // dimension secondaire a varier (ex. stat "SPEED", critere "TYPE")
  createdAt DateTime @default(now())

  @@index([game, scope, pickDate])
  @@index([game, scope, pokemonId])
  @@index([game, scope, detail])
}

/// Resultat quotidien d'un joueur connecte pour un defi (jeu x scope x jour). Sert au verrou serveur
/// de l'unicite quotidienne, a l'historique joueur et aux futurs classements. Une seule ligne par
/// (utilisateur, jeu, scope, jour). Les invites ne sont pas persistes (localStorage cote client).
model DailyResult {
  id              String   @id @default(uuid())
  userId          String
  gameType        String // "WHO_IS_IT", "MOTUS", ...
  scope           String   @default("") // niveau et/ou mode ("FACILE", "FIND_SHINY:MOYEN", ...)
  dayDate         DateTime @db.Date // jour UTC du defi
  won             Boolean  @default(false)
  // Metriques generiques : chaque jeu renseigne celles qui le concernent (classement selon le jeu).
  attempts        Int? // Silhouette / Motus : nombre d'essais
  score           Int? // ex. Who-is-it : capital restant
  correctCount    Int? // Plus ou Moins / Intrus / Shiny / Juste Stat : bonnes reponses
  totalRounds     Int?
  durationSeconds Int?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameType, scope, dayDate])
  @@index([gameType, scope, dayDate])
  @@index([userId, dayDate])
}

